{
  "name": "j365-spa-logger",
  "version": "6.52.1",
  "private": true,
  "description": "Static spa logger regression tooling; no production runtime dependencies",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "test": "node scripts/test.cjs",
    "build:time": "node scripts/build-time.cjs",
    "build:pwa": "node scripts/build-pwa.cjs",
    "check:generated": "node scripts/build-time.cjs --check && node scripts/build-pwa.cjs --check"
  },
  "devDependencies": { "jsdom": "30.1.2" }
}
